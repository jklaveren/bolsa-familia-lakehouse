# Copie para .env e troque TODOS os valores. O .env nunca vai para o Git.
#   cp .env.example .env

# Airflow local
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=troque-esta-senha
AIRFLOW_ADMIN_FIRSTNAME=Admin
AIRFLOW_ADMIN_LASTNAME=User
AIRFLOW_ADMIN_EMAIL=admin@example.com

# Postgres local (mesmos valores usados pelo compose e pelo Terraform)
POSTGRES_USER=airflow
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=airflow

# LGPD: salt do hash do NIS. Nao use este valor em producao.
BOLSA_FAMILIA_PSEUDONYM_SALT=troque-este-salt

# Databricks (Free Edition ou pago) — necessario para dbt/Airflow
DATABRICKS_HOST=
DATABRICKS_HTTP_PATH=
DATABRICKS_TOKEN=
DATABRICKS_CATALOG=workspace
