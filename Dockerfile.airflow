# Estende a imagem oficial do Airflow com um JDK (necessario para o PySpark
# rodar dentro das tasks) e com pyspark/delta-spark/dbt-databricks JA
# instalados na imagem — evita depender de _PIP_ADDITIONAL_REQUIREMENTS
# (que re-baixa tudo TODA VEZ que um container sobe, e falha se a internet
# cair no meio do boot).
FROM apache/airflow:2.9.3

USER root
RUN apt-get update && \
    apt-get install -y --no-install-recommends openjdk-17-jdk-headless && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*
ENV JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64

USER airflow
RUN pip install --no-cache-dir pyspark==3.5.1 delta-spark==3.2.0 dbt-databricks==1.8.4 google-generativeai==0.8.3 python-dotenv==1.0.1
